---
// Abstract line-art evoking Madison's isthmus between Lake Mendota (top)
// and Lake Monona (bottom), with the Capitol dome as a small landmark.
// Purely decorative — hidden from assistive tech.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 800 400"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M0,60 C120,20 220,90 340,55 C460,20 560,80 680,45 C740,28 780,40 800,55 L800,0 L0,0 Z"
    fill="var(--motif-fill, var(--color-lake-bright))"
    opacity="0.16"
  />
  <path
    d="M0,340 C130,380 240,310 360,345 C480,380 580,320 700,355 C750,372 780,362 800,348 L800,400 L0,400 Z"
    fill="var(--motif-fill, var(--color-lake-bright))"
    opacity="0.16"
  />
  <circle cx="400" cy="118" r="5" fill="var(--color-gold)" opacity="0.8" />
  <path
    d="M400,118 L400,150 M382,150 L418,150 M388,150 C388,132 412,132 412,150"
    stroke="var(--color-gold)"
    stroke-width="3"
    fill="none"
    opacity="0.8"
    stroke-linecap="round"
  />
</svg>
