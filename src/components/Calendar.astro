---
interface CalRide {
  id: string;
  kind: 'ride';
  name: string;
  href: string;
  days: string[];
  time?: string;
  seasonStart?: string;
  seasonEnd?: string;
}

interface CalEvent {
  id: string;
  kind: 'event';
  name: string;
  href: string;
  dateISO: string;
  time?: string;
}

interface Props {
  items: (CalRide | CalEvent)[];
}

const { items } = Astro.props;
const itemsJson = JSON.stringify(items).replace(/</g, '\\u003c');

const WEEKDAY_LABELS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
---

<div class="calendar" data-calendar>
  <div class="calendar__toolbar">
    <div class="calendar__nav">
      <button type="button" data-cal-prev aria-label="Previous month">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <h2 data-cal-label></h2>
      <button type="button" data-cal-next aria-label="Next month">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>
    <div class="calendar__controls">
      <button type="button" data-cal-today class="btn btn--secondary calendar__today">Today</button>
      <label class="cal-toggle">
        <input type="checkbox" data-cal-toggle="ride" checked />
        <span class="cal-toggle__dot cal-toggle__dot--ride"></span> Recurring rides
      </label>
      <label class="cal-toggle">
        <input type="checkbox" data-cal-toggle="event" checked />
        <span class="cal-toggle__dot cal-toggle__dot--event"></span> Events
      </label>
    </div>
  </div>

  <div class="cal-grid cal-grid--header">
    {WEEKDAY_LABELS.map((d) => <div class="cal-grid__weekday">{d}</div>)}
  </div>
  <div class="cal-grid" data-cal-grid></div>

  <script type="application/json" id="calendar-data" set:html={itemsJson} is:inline />
</div>

<style>
  .calendar {
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    background: #fff;
  }

  .calendar__toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-line);
  }

  .calendar__nav {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .calendar__nav h2 {
    margin: 0;
    min-width: 12rem;
    text-align: center;
    font-size: 1.15rem;
  }

  .calendar__nav button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 999px;
    background: #fff;
    color: var(--color-ink);
    cursor: pointer;
  }

  .calendar__nav button:hover {
    background: var(--color-paper-alt);
  }

  .calendar__controls {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .calendar__today {
    padding: 0.4em 1em;
    font-size: 0.85rem;
  }

  .cal-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-ink-soft);
    cursor: pointer;
  }

  .cal-toggle__dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .cal-toggle__dot--ride {
    background: var(--color-lake-bright);
  }

  .cal-toggle__dot--event {
    background: var(--color-cardinal);
  }

  .cal-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
  }

  .cal-grid--header {
    border-bottom: 1px solid var(--color-line);
    background: var(--color-paper-alt);
  }

  .cal-grid__weekday {
    padding: 0.5em;
    text-align: center;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }
</style>

<style is:global>
  /* Cells are injected client-side by calendar.ts, so this must stay global. */
  .cal-cell {
    min-width: 0;
    min-height: 6rem;
    padding: 0.4em;
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    display: flex;
    flex-direction: column;
    gap: 0.3em;
  }

  .cal-cell.is-outside {
    background: var(--color-paper-alt);
  }

  .cal-cell.is-outside .cal-cell__date {
    color: var(--color-ink-soft);
    opacity: 0.6;
  }

  .cal-cell.is-today .cal-cell__date {
    background: var(--color-cardinal);
    color: #fff;
  }

  .cal-cell__date {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.6em;
    height: 1.6em;
    border-radius: 50%;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .cal-cell__entries {
    display: flex;
    flex-direction: column;
    gap: 0.2em;
    overflow-y: auto;
    max-height: 6rem;
  }

  .cal-entry {
    display: block;
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.3;
    padding: 0.15em 0.4em;
    border-radius: 0.3em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-decoration: none;
  }

  .cal-entry--ride {
    background: var(--color-lake-tint);
    color: var(--color-lake-deep);
  }

  .cal-entry--event {
    background: rgba(197, 5, 12, 0.12);
    color: var(--color-cardinal-deep);
  }

  .cal-entry:hover {
    text-decoration: underline;
  }

  .calendar.hide-ride .cal-entry--ride {
    display: none;
  }

  .calendar.hide-event .cal-entry--event {
    display: none;
  }

  @media (max-width: 700px) {
    .cal-grid__weekday {
      font-size: 0.65rem;
    }

    .cal-cell {
      min-height: 4.5rem;
      font-size: 0.9em;
    }

    .cal-entry {
      font-size: 0.65rem;
    }
  }
</style>

<script src="../scripts/calendar.ts"></script>
