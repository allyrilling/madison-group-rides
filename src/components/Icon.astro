---
// Small hand-picked line-icon set (stroke style, 24x24) so we don't
// pull in an icon library for ~a dozen glyphs.
interface Props {
  name:
    | 'bike'
    | 'calendar'
    | 'clock'
    | 'map-pin'
    | 'filter'
    | 'external-link'
    | 'road'
    | 'gravel'
    | 'mountain'
    | 'trail'
    | 'menu'
    | 'close'
    | 'arrow-right'
    | 'users'
    | 'map'
    | 'ruler'
    | 'gauge';
  class?: string;
}
const { name, class: className = '' } = Astro.props;

const paths: Record<Props['name'], string> = {
  bike: 'M5 17a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm14 0a3 3 0 1 0 0 6 3 3 0 0 0 0-6ZM8 20l3-8h5l3 6M11 12 9 6H6M13 6h4',
  calendar: 'M4 5h16v16H4V5Zm0 5h16M8 3v4M16 3v4',
  clock: 'M12 12V7m0 5 4 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
  'map-pin': 'M12 21s7-6.4 7-11.5A7 7 0 0 0 5 9.5C5 14.6 12 21 12 21Zm0-9a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
  filter: 'M4 5h16M7 12h10M10 19h4',
  'external-link': 'M14 4h6v6M20 4l-9 9M9 4H5a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-4',
  road: 'M9 4 5 20M15 4l4 16M12 4v3m0 5v3m0 5v1',
  gravel: 'M4 18l4-9 3 5 3-7 3 6 3-4',
  mountain: 'M3 19h18L14 6l-3.5 6L9 9l-6 10Z',
  trail: 'M4 20c3-1 4-4 4-6 0-3-3-3-3-6a5 5 0 0 1 10 0c0 3-3 3-3 6 0 2 1 5 4 6',
  menu: 'M4 7h16M4 12h16M4 17h16',
  close: 'M6 6l12 12M18 6 6 18',
  'arrow-right': 'M5 12h14M13 6l6 6-6 6',
  users: 'M8 14a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm8 0a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7ZM2 21c0-3.3 2.7-6 6-6s6 2.7 6 6M14 15.5c2.9.4 4.9 2.7 4.9 5.5',
  map: 'M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2Zm0 0v14m6-12v14',
  ruler: 'M3 9h18v6H3V9Z M7 9v3M11 9v3M15 9v3M19 9v3',
  gauge: 'M4 16a8 8 0 0 1 16 0M12 16 16 10',
};

const d = paths[name];
---

<svg
  class={className}
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={d}></path>
</svg>
