---
import IsthmusMotif from './IsthmusMotif.astro';

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="page-hero">
  <IsthmusMotif class="page-hero__motif" />
  <div class="container page-hero__inner">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {description && <p class="lede">{description}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    background: var(--color-paper-alt);
    border-bottom: 1px solid var(--color-line);
    overflow: hidden;
    padding-block: var(--space-6);
  }

  .page-hero__motif {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .page-hero__inner {
    position: relative;
    z-index: 1;
  }
</style>
