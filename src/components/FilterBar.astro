---
import Icon from './Icon.astro';

interface FilterGroup {
  key: string;
  label: string;
  options: { value: string; label: string }[];
}

interface Props {
  groups: FilterGroup[];
  nounSingular: string;
  nounPlural: string;
  searchPlaceholder?: string;
}

const { groups, nounSingular, nounPlural, searchPlaceholder = 'Search by name or organizer…' } = Astro.props;
---

<div class="filter-bar" data-noun-singular={nounSingular} data-noun-plural={nounPlural}>
  <button type="button" class="filter-bar__toggle" data-filter-toggle aria-expanded="true" aria-controls="filter-panel">
    <Icon name="filter" class="filter-bar__toggle-icon" />
    <span>Filters</span>
    <span class="filter-bar__toggle-count" data-filter-active-count hidden>0</span>
    <Icon name="chevron-down" class="filter-bar__toggle-chevron" />
  </button>

  <div class="filter-bar__panel" data-filter-panel id="filter-panel">
    <div class="filter-bar__search">
      <Icon name="filter" class="filter-bar__search-icon" />
      <input type="search" data-filter-search placeholder={searchPlaceholder} aria-label={searchPlaceholder} />
    </div>

    <div class="filter-bar__groups">
      {groups.map((group) => (
        <fieldset class="filter-bar__group">
          <legend>{group.label}</legend>
          <div class="filter-bar__chips">
            {group.options.map((opt) => (
              <label class="filter-chip">
                <input type="checkbox" name={group.key} value={opt.value} />
                <span>{opt.label}</span>
              </label>
            ))}
          </div>
        </fieldset>
      ))}
    </div>

    <div class="filter-bar__footer">
      <p class="filter-bar__count" data-filter-count aria-live="polite"></p>
      <button type="button" data-filter-clear class="btn btn--ghost">Clear filters</button>
    </div>
  </div>
</div>

<style>
  .filter-bar {
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  .filter-bar__toggle {
    display: none;
    width: 100%;
    align-items: center;
    gap: 0.6em;
    padding: var(--space-3) var(--space-4);
    background: none;
    border: none;
    font: inherit;
    font-weight: 700;
    color: var(--color-ink);
    cursor: pointer;
    text-align: left;
  }

  .filter-bar__toggle-icon {
    width: 18px;
    height: 18px;
    color: var(--color-lake);
    flex-shrink: 0;
  }

  .filter-bar__toggle-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.4em;
    height: 1.4em;
    padding: 0 0.4em;
    border-radius: 999px;
    background: var(--color-cardinal);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .filter-bar__toggle-chevron {
    width: 16px;
    height: 16px;
    margin-left: auto;
    flex-shrink: 0;
    transition: transform 0.15s ease;
  }

  .filter-bar__toggle[aria-expanded='true'] .filter-bar__toggle-chevron {
    transform: rotate(180deg);
  }

  .filter-bar__panel {
    padding: var(--space-4);
  }

  .filter-bar__search {
    display: flex;
    align-items: center;
    gap: 0.5em;
    border: 1.5px solid var(--color-line-strong);
    border-radius: 999px;
    padding: 0.5em 1em;
    margin-bottom: var(--space-3);
  }

  .filter-bar__search-icon {
    width: 18px;
    height: 18px;
    color: var(--color-lake);
    flex-shrink: 0;
  }

  .filter-bar__search input {
    border: none;
    outline: none;
    font: inherit;
    width: 100%;
    background: transparent;
  }

  .filter-bar__groups {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .filter-bar__group {
    border: none;
    padding: 0;
    margin: 0;
    min-width: 0;
  }

  .filter-bar__group legend {
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-lake-deep);
    padding: 0 0 0.5em;
  }

  .filter-bar__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em;
  }

  .filter-chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.35em 0.8em;
    border-radius: 999px;
    border: 1.5px solid var(--color-line-strong);
    color: var(--color-ink-soft);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .filter-chip input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .filter-chip:has(input:checked) {
    background: var(--color-lake-deep);
    border-color: var(--color-lake-deep);
    color: var(--color-paper);
  }

  .filter-chip:has(input:focus-visible) {
    outline: 3px solid var(--color-gold);
    outline-offset: 2px;
  }

  .filter-bar__footer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    border-top: 1px solid var(--color-line);
    padding-top: var(--space-3);
  }

  .filter-bar__count {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-ink-soft);
  }

  @media (max-width: 959px) {
    .filter-bar__toggle {
      display: flex;
    }

    .filter-bar__panel {
      border-top: 1px solid var(--color-line);
    }
  }
</style>

<script src="../scripts/filter.ts"></script>
