---
import Icon from './Icon.astro';
import { ORGANIZER_TYPE_LABELS } from '../lib/labels';

interface RelatedItem {
  href: string;
  label: string;
}

interface Props {
  name: string;
  type: string;
  address?: string;
  phone?: string;
  hours?: string;
  website?: string;
  social?: Record<string, string | undefined>;
  related?: RelatedItem[];
  hasNotes?: boolean;
  filterData?: Record<string, string>;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  Content: any;
}

const {
  name,
  type,
  address,
  phone,
  hours,
  website,
  social,
  related = [],
  hasNotes = false,
  filterData = {},
  Content,
} = Astro.props;

const socialEntries = Object.entries(social ?? {}).filter(([, v]) => v) as [string, string][];
---

<div
  class="listing-card organizer-card"
  {...Object.fromEntries(Object.entries(filterData).map(([k, v]) => [`data-${k}`, v]))}
>
  <span class="tag tag--cardinal organizer-card__type">{ORGANIZER_TYPE_LABELS[type] ?? type}</span>
  <h3 class="listing-card__title">{name}</h3>

  <div class="organizer-card__body">
    <Content />
  </div>

  {
    (address || phone || hours) && (
      <dl class="organizer-card__facts">
        {address && (
          <div>
            <dt><Icon name="map-pin" /> Address</dt>
            <dd>{address}</dd>
          </div>
        )}
        {phone && (
          <div>
            <dt>Phone</dt>
            <dd><a href={`tel:${phone.replace(/[^\d+]/g, '')}`}>{phone}</a></dd>
          </div>
        )}
        {hours && (
          <div>
            <dt><Icon name="clock" /> Hours</dt>
            <dd>{hours}</dd>
          </div>
        )}
      </dl>
    )
  }

  <div class="organizer-card__links">
    {website && (
      <a href={website} target="_blank" rel="noopener noreferrer">
        Website <Icon name="external-link" />
      </a>
    )}
    {socialEntries.map(([platform, url]) => (
      <a href={url} target="_blank" rel="noopener noreferrer">
        {platform.charAt(0).toUpperCase() + platform.slice(1)} <Icon name="external-link" />
      </a>
    ))}
  </div>

  {
    related.length > 0 && (
      <div class="organizer-card__related">
        <p class="organizer-card__related-label">Rides &amp; events</p>
        <ul>
          {related.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  {hasNotes && <p class="listing-card__flag">⚠ Details unconfirmed — check the source before you go</p>}
</div>

<style>
  .organizer-card {
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .organizer-card__type {
    align-self: flex-start;
    margin-bottom: var(--space-2);
  }

  .organizer-card__body {
    color: var(--color-ink-soft);
    font-size: 0.92rem;
    margin-bottom: var(--space-3);
  }

  .organizer-card__body :global(p) {
    margin: 0 0 0.6em;
  }

  .organizer-card__body :global(p:last-child) {
    margin-bottom: 0;
  }

  .organizer-card__facts {
    margin: 0 0 var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-line);
  }

  .organizer-card__facts > div {
    margin-bottom: 0.6em;
  }

  .organizer-card__facts > div:last-child {
    margin-bottom: 0;
  }

  .organizer-card__facts dt {
    display: flex;
    align-items: center;
    gap: 0.35em;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-lake);
    margin-bottom: 0.2em;
  }

  .organizer-card__facts dt :global(svg) {
    width: 14px;
    height: 14px;
  }

  .organizer-card__facts dd {
    margin: 0;
    font-weight: 600;
  }

  .organizer-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9em;
    margin-top: auto;
    padding-top: var(--space-3);
  }

  .organizer-card__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-lake-deep);
    text-decoration: none;
  }

  .organizer-card__links a:hover {
    text-decoration: underline;
  }

  .organizer-card__links :global(svg) {
    width: 14px;
    height: 14px;
  }

  .organizer-card__related {
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-line);
  }

  .organizer-card__related-label {
    margin: 0 0 0.4em;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-lake);
  }

  .organizer-card__related ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3em;
  }

  .organizer-card__related a {
    font-size: 0.9rem;
    font-weight: 600;
  }
</style>
