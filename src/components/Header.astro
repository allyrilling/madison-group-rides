---
const navLinks = [
  { href: '/rides/', label: 'Recurring Rides' },
  { href: '/events/', label: 'Events' },
  { href: '/map/', label: 'Map' },
  { href: '/submit/', label: 'Submit a Ride' },
  { href: '/about/', label: 'About' },
];
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/">
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 48 48" width="34" height="34">
          <circle cx="24" cy="24" r="22" fill="var(--color-ink)"></circle>
          <path
            d="M15 34h18 M17 34c0-10 14-10 14 0 M24 24V12"
            stroke="var(--color-gold)"
            stroke-width="2.4"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
          <circle cx="24" cy="11" r="2.6" fill="var(--color-gold)"></circle>
        </svg>
      </span>
      <span class="brand__text">Madison Group Rides</span>
    </a>

    <button class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="primary-nav">
      <span class="visually-hidden">Toggle menu</span>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>

    <nav id="primary-nav" class="primary-nav">
      {navLinks.map((link) => (
        <a
          href={link.href}
          aria-current={currentPath === link.href ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--color-lake-bright);
    color: var(--color-ink);
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 3px solid var(--color-gold);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-2);
    gap: var(--space-3);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6em;
    color: var(--color-ink);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.2rem;
  }

  .brand:hover {
    text-decoration: underline;
  }

  .primary-nav {
    display: flex;
    gap: var(--space-4);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .primary-nav a {
    color: var(--color-ink);
    text-decoration: none;
    padding-block: 0.3em;
    border-bottom: 2px solid transparent;
  }

  .primary-nav a:hover,
  .primary-nav a[aria-current='page'] {
    border-bottom-color: var(--color-gold);
  }

  .nav-toggle {
    display: none;
    background: transparent;
    border: 1px solid rgba(36, 36, 36, 0.4);
    color: var(--color-ink);
    border-radius: var(--radius-sm);
    padding: 0.4em;
  }

  @media (max-width: 780px) {
    .nav-toggle {
      display: inline-flex;
    }

    .primary-nav {
      position: absolute;
      inset-inline: 0;
      top: 100%;
      background: var(--color-lake-bright);
      flex-direction: column;
      padding: var(--space-3) var(--space-4);
      gap: var(--space-2);
      border-bottom: 3px solid var(--color-gold);
      display: none;
    }

    .primary-nav.is-open {
      display: flex;
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('primary-nav');
  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });
</script>
