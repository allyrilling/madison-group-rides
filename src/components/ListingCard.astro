---
import Icon from './Icon.astro';
import { TERRAIN_ICONS, TERRAIN_LABELS } from '../lib/labels.ts';

interface Props {
  href: string;
  name: string;
  organizerName?: string;
  metaLine: string;
  distanceLabel?: string | null;
  paceLabel?: string | null;
  dropLabel?: string | null;
  terrain: string[];
  featured?: boolean;
  hasNotes?: boolean;
  // data attributes consumed by the client-side filter script
  filterData?: Record<string, string>;
}

const {
  href,
  name,
  organizerName,
  metaLine,
  distanceLabel,
  paceLabel,
  dropLabel,
  terrain,
  featured = false,
  hasNotes = false,
  filterData = {},
} = Astro.props;
---

<a href={href} class="listing-card" {...Object.fromEntries(Object.entries(filterData).map(([k, v]) => [`data-${k}`, v]))}>
  {featured && <span class="listing-card__featured tag tag--gold">Featured</span>}
  <h3 class="listing-card__title">{name}</h3>
  {organizerName && <p class="listing-card__organizer">{organizerName}</p>}
  <p class="listing-card__meta">
    <Icon name="clock" class="listing-card__meta-icon" />
    {metaLine}
  </p>
  <div class="listing-card__stats">
    {distanceLabel && (
      <span class="tag">
        <Icon name="ruler" class="tag__icon" />
        {distanceLabel}
      </span>
    )}
    {paceLabel && (
      <span class="tag">
        <Icon name="gauge" class="tag__icon" />
        {paceLabel}
      </span>
    )}
    {dropLabel && (
      <span class="tag">
        <Icon name="users" class="tag__icon" />
        {dropLabel}
      </span>
    )}
    {terrain.map((t) => (
      <span class="tag tag--cardinal">
        <Icon name={TERRAIN_ICONS[t] ?? 'bike'} class="tag__icon" />
        {TERRAIN_LABELS[t] ?? t}
      </span>
    ))}
  </div>
  {hasNotes && <p class="listing-card__flag">⚠ Details unconfirmed — check the source before you go</p>}
</a>

<style>
  .listing-card {
    display: block;
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    padding: var(--space-3);
    text-decoration: none;
    color: var(--color-ink);
    box-shadow: var(--shadow-card);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    position: relative;
  }

  .listing-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(36, 36, 36, 0.08), 0 12px 28px rgba(36, 36, 36, 0.1);
  }

  .listing-card__featured {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
  }

  .listing-card__title {
    font-size: 1.15rem;
    margin-bottom: 0.2em;
    padding-right: 4.5rem;
    color: var(--color-lake-deep);
  }

  .listing-card__organizer {
    font-weight: 600;
    color: var(--color-cardinal-deep);
    font-size: 0.88rem;
    margin-bottom: 0.5em;
  }

  .listing-card__meta {
    display: flex;
    align-items: center;
    gap: 0.4em;
    color: var(--color-ink-soft);
    font-size: 0.9rem;
    margin-bottom: var(--space-3);
  }

  .listing-card__meta-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .listing-card__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em;
  }

  .tag__icon {
    width: 13px;
    height: 13px;
    margin-right: 0.3em;
  }

  .listing-card__flag {
    margin: var(--space-2) 0 0;
    font-size: 0.8rem;
    color: var(--color-gold-ink);
  }
</style>
