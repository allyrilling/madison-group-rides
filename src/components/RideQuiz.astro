---
import Icon from './Icon.astro';

interface Option {
  value: string;
  label: string;
}

interface Props {
  dayOptions: Option[];
  paceOptions: Option[];
  terrainOptions: Option[];
}

const { dayOptions, paceOptions, terrainOptions } = Astro.props;
---

<div class="ride-quiz" data-ride-quiz>
  <button
    type="button"
    class="ride-quiz__toggle"
    data-ride-quiz-toggle
    aria-expanded="false"
    aria-controls="ride-quiz-panel"
  >
    <Icon name="bike" class="ride-quiz__toggle-icon" />
    <span>
      <strong>Not sure where to start?</strong>
      Answer a few quick questions and we'll narrow the list down for you.
    </span>
    <Icon name="chevron-down" class="ride-quiz__toggle-chevron" />
  </button>

  <div class="ride-quiz__panel" data-ride-quiz-panel id="ride-quiz-panel" hidden>
    <div class="ride-quiz__question" data-quiz-group="day">
      <p class="ride-quiz__label">What day works for you?</p>
      <div class="ride-quiz__chips">
        {dayOptions.map((opt) => (
          <button type="button" class="ride-quiz__chip" data-quiz-value={opt.value}>
            {opt.label}
          </button>
        ))}
      </div>
    </div>

    <div class="ride-quiz__question" data-quiz-group="pace">
      <p class="ride-quiz__label">How intense of a ride?</p>
      <div class="ride-quiz__chips">
        {paceOptions.map((opt) => (
          <button type="button" class="ride-quiz__chip" data-quiz-value={opt.value}>
            {opt.label}
          </button>
        ))}
      </div>
    </div>

    <div class="ride-quiz__question" data-quiz-group="terrain">
      <p class="ride-quiz__label">What terrain do you like?</p>
      <div class="ride-quiz__chips">
        {terrainOptions.map((opt) => (
          <button type="button" class="ride-quiz__chip" data-quiz-value={opt.value}>
            {opt.label}
          </button>
        ))}
      </div>
    </div>

    <div class="ride-quiz__footer">
      <button type="button" class="btn btn--primary" data-ride-quiz-submit>Show my rides</button>
      <button type="button" class="btn btn--ghost" data-ride-quiz-reset>Reset</button>
    </div>
  </div>
</div>

<style>
  .ride-quiz {
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    margin-bottom: var(--space-4);
  }

  .ride-quiz__toggle {
    display: flex;
    align-items: center;
    gap: 0.8em;
    width: 100%;
    padding: var(--space-3) var(--space-4);
    background: var(--color-paper-alt);
    border: none;
    font: inherit;
    text-align: left;
    cursor: pointer;
    color: var(--color-ink);
  }

  .ride-quiz__toggle-icon {
    width: 22px;
    height: 22px;
    color: var(--color-lake);
    flex-shrink: 0;
  }

  .ride-quiz__toggle span {
    flex: 1;
    font-size: 0.88rem;
    color: var(--color-ink-soft);
  }

  .ride-quiz__toggle strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--color-lake-deep);
  }

  .ride-quiz__toggle-chevron {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    transition: transform 0.15s ease;
  }

  .ride-quiz__toggle[aria-expanded='true'] .ride-quiz__toggle-chevron {
    transform: rotate(180deg);
  }

  .ride-quiz__panel {
    padding: var(--space-4);
    border-top: 1px solid var(--color-line);
  }

  .ride-quiz__question + .ride-quiz__question {
    margin-top: var(--space-3);
  }

  .ride-quiz__label {
    font-weight: 700;
    font-size: 0.85rem;
    margin-bottom: 0.5em;
  }

  .ride-quiz__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em;
  }

  .ride-quiz__chip {
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.35em 0.9em;
    border-radius: 999px;
    border: 1.5px solid var(--color-line-strong);
    background: #fff;
    color: var(--color-ink-soft);
    cursor: pointer;
  }

  .ride-quiz__chip.is-selected {
    background: var(--color-lake-deep);
    border-color: var(--color-lake-deep);
    color: #fff;
  }

  .ride-quiz__footer {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
</style>

<script src="../scripts/ride-quiz.ts"></script>
