---
import { getCollection, render } from 'astro:content';
import DetailPage from '../../components/DetailPage.astro';
import { resolveOrganizerEntry } from '../../lib/organizer';
import { formatDistance, formatEventDate, PACE_LABELS, TERRAIN_LABELS, TERRAIN_ICONS } from '../../lib/labels';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((event) => ({ params: { slug: event.id }, props: { event } }));
}

const { event } = Astro.props;
const { Content } = await render(event);
const organizer = await resolveOrganizerEntry(event.data);
const organizerName = organizer?.data.name ?? event.data.organizerName;

const distanceLabel = formatDistance(event.data.distanceMiles);
const paceLabel = event.data.paceCategory ? PACE_LABELS[event.data.paceCategory] : null;

const badges: { icon: 'ruler' | 'gauge' | 'users' | 'road' | 'gravel' | 'mountain' | 'trail' | 'bike'; label: string }[] = [];
if (distanceLabel) badges.push({ icon: 'ruler', label: distanceLabel });
if (paceLabel) badges.push({ icon: 'gauge', label: paceLabel });
for (const t of event.data.terrain) {
  badges.push({ icon: TERRAIN_ICONS[t] ?? 'bike', label: TERRAIN_LABELS[t] ?? t });
}

const mapMarkers =
  event.data.startLocation.lat != null && event.data.startLocation.lng != null
    ? [
        {
          id: event.id,
          kind: 'event' as const,
          name: event.data.name,
          organizerName,
          lat: event.data.startLocation.lat,
          lng: event.data.startLocation.lng,
          href: `/events/${event.id}/`,
          summary: formatEventDate(event.data),
        },
      ]
    : [];
---

<DetailPage
  eyebrow="One-Time / Annual Event"
  title={event.data.name}
  scheduleLabel={formatEventDate(event.data)}
  badges={badges}
  description={event.data.description}
  locationName={event.data.startLocation.name}
  locationAddress={event.data.startLocation.address}
  cost={event.data.cost}
  organizerName={organizerName}
  organizerWebsite={organizer?.data.website}
  organizerSocial={organizer?.data.social}
  website={event.data.website}
  registrationUrl={event.data.registrationUrl}
  sourceUrl={event.data.sourceUrl}
  notes={event.data.notes}
  active={event.data.active}
  mapMarkers={mapMarkers}
  backHref="/events/"
  backLabel="All events"
>
  <Content />
</DetailPage>
