---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
---

<BaseLayout title="Thanks!" description="Thanks for submitting a ride to the Bike Madison catalog.">
  <PageHero
    eyebrow="Submitted"
    title="Thanks for the tip"
    description="A person reviews every submission before it's added to the catalog — we'll take it from here. If you included your email, we may follow up with a question."
  />
  <section class="section">
    <div class="container">
      <a class="btn btn--secondary" href="/rides/">Back to Recurring Rides</a>
      <a class="btn btn--ghost" href="/">Home</a>
    </div>
  </section>
</BaseLayout>
