---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import FilterBar from '../components/FilterBar.astro';
import Icon from '../components/Icon.astro';
import { ORGANIZER_TYPE_LABELS } from '../lib/labels';

const groups = await getCollection('organizers', ({ data }) => data.type !== 'shop');
const rides = await getCollection('rides', ({ data }) => data.active);
const events = await getCollection('events', ({ data }) => data.active);

function relatedFor(organizerId: string) {
  const relRides = rides
    .filter((r) => r.data.organizer?.id === organizerId)
    .map((r) => ({ href: `/rides/${r.id}/`, label: r.data.name }));
  const relEvents = events
    .filter((e) => e.data.organizer?.id === organizerId)
    .map((e) => ({ href: `/events/${e.id}/`, label: e.data.name }));
  return [...relRides, ...relEvents];
}

const rows = await Promise.all(
  groups.map(async (group) => {
    const { Content } = await render(group);
    return {
      id: group.id,
      name: group.data.name,
      type: group.data.type,
      address: group.data.address,
      phone: group.data.phone,
      hours: group.data.hours,
      website: group.data.website,
      social: group.data.social,
      related: relatedFor(group.id),
      Content,
    };
  })
);

rows.sort((a, b) => a.name.localeCompare(b.name));

const TYPE_ORDER = ['club', 'team', 'nonprofit', 'informal-group'];

const filterGroups = [
  {
    key: 'type',
    label: 'Type',
    options: TYPE_ORDER.map((value) => ({ value, label: ORGANIZER_TYPE_LABELS[value] })),
  },
];
---

<BaseLayout
  title="Bike Groups"
  description="Cycling clubs, teams, and informal group-ride communities around Madison, WI."
>
  <PageHero
    eyebrow="Bike Groups"
    title="Clubs & community groups"
    description="Cycling clubs, race teams, advocacy nonprofits, and informal groups around Madison — join one to find riding partners at your pace."
  />

  <section class="section">
    <div class="container">
      <FilterBar
        groups={filterGroups}
        nounSingular="group"
        nounPlural="groups"
        searchPlaceholder="Search groups…"
      />
      <p data-filter-empty hidden class="empty-state">
        No groups match those filters — try clearing one or two.
      </p>

      <div class="table-scroll">
        <table class="group-table">
          <thead>
            <tr>
              <th scope="col">Group</th>
              <th scope="col">Type</th>
              <th scope="col">Contact</th>
              <th scope="col">Links</th>
              <th scope="col">Rides &amp; events</th>
            </tr>
          </thead>
          <tbody data-filter-grid>
            {
              rows.map((row) => (
                <tr class="listing-card" id={row.id} data-type={row.type}>
                  <th scope="row">
                    <span class="group-table__name">{row.name}</span>
                    <div class="group-table__desc">
                      <row.Content />
                    </div>
                  </th>
                  <td>
                    <span class="tag tag--cardinal">{ORGANIZER_TYPE_LABELS[row.type] ?? row.type}</span>
                  </td>
                  <td>
                    {row.address || row.phone || row.hours ? (
                      <div class="group-table__contact">
                        {row.address && (
                          <span>
                            <Icon name="map-pin" class="group-table__icon" />
                            {row.address}
                          </span>
                        )}
                        {row.phone && (
                          <span>
                            <a href={`tel:${row.phone.replace(/[^\d+]/g, '')}`}>{row.phone}</a>
                          </span>
                        )}
                        {row.hours && (
                          <span>
                            <Icon name="clock" class="group-table__icon" />
                            {row.hours}
                          </span>
                        )}
                      </div>
                    ) : (
                      '—'
                    )}
                  </td>
                  <td>
                    <div class="group-table__links">
                      {row.website && (
                        <a href={row.website} target="_blank" rel="noopener noreferrer">
                          Website
                        </a>
                      )}
                      {Object.entries(row.social ?? {})
                        .filter(([, v]) => v)
                        .map(([platform, url]) => (
                          <a href={url as string} target="_blank" rel="noopener noreferrer">
                            {platform.charAt(0).toUpperCase() + platform.slice(1)}
                          </a>
                        ))}
                      {!row.website && !Object.values(row.social ?? {}).some(Boolean) && '—'}
                    </div>
                  </td>
                  <td>
                    {row.related.length > 0 ? (
                      <ul class="group-table__related">
                        {row.related.map((item) => (
                          <li>
                            <a href={item.href}>{item.label}</a>
                          </li>
                        ))}
                      </ul>
                    ) : (
                      '—'
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .table-scroll {
    overflow-x: auto;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    background: #fff;
  }

  .group-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .group-table th,
  .group-table td {
    padding: var(--space-3);
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--color-line);
  }

  .group-table thead th {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-lake-deep);
    background: var(--color-paper-alt);
    white-space: nowrap;
  }

  .group-table tbody tr:last-child th,
  .group-table tbody tr:last-child td {
    border-bottom: none;
  }

  .group-table tbody tr[hidden] {
    display: none;
  }

  .group-table tbody th {
    font-weight: 600;
    min-width: 14rem;
  }

  .group-table__name {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-lake-deep);
    margin-bottom: 0.3em;
  }

  .group-table__desc {
    font-weight: 400;
    font-size: 0.85rem;
    color: var(--color-ink-soft);
  }

  .group-table__desc :global(p) {
    margin: 0;
  }

  .group-table__contact {
    display: flex;
    flex-direction: column;
    gap: 0.3em;
  }

  .group-table__icon {
    width: 13px;
    height: 13px;
    color: var(--color-lake);
    vertical-align: -1px;
    margin-right: 0.2em;
  }

  .group-table__links {
    display: flex;
    flex-direction: column;
    gap: 0.3em;
  }

  .group-table__links a {
    font-weight: 600;
    color: var(--color-lake-deep);
    white-space: nowrap;
  }

  .group-table__related {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3em;
  }

  .group-table__related a {
    font-weight: 600;
    white-space: nowrap;
  }
</style>
