---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout
  title="Submit a Ride"
  description="Know a Madison-area group ride that's missing from the catalog? Submit it here."
>
  <PageHero
    eyebrow="Submit a Ride"
    title="Help grow the catalog"
    description="Run a shop ride, club ride, or event that isn't listed yet? Or spot something out of date? Tell us about it below — every submission is reviewed by a person before it's added."
  />

  <section class="section">
    <div class="container container--narrow">
      <form
        name="ride-submission"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/submit/thanks/"
        class="submit-form"
      >
        <input type="hidden" name="form-name" value="ride-submission" />
        <p class="visually-hidden">
          <label>
            Don't fill this out if you're human: <input name="bot-field" />
          </label>
        </p>

        <div class="form-row">
          <label for="ride-name">Ride or event name *</label>
          <input id="ride-name" name="ride-name" type="text" required />
        </div>

        <div class="form-row">
          <label for="organizer">Organizer / host</label>
          <input id="organizer" name="organizer" type="text" placeholder="Shop, club, or organizer name" />
        </div>

        <div class="form-row">
          <label for="ride-type">Type *</label>
          <select id="ride-type" name="ride-type" required>
            <option value="">Select one…</option>
            <option value="recurring">Recurring (weekly/seasonal)</option>
            <option value="one-time">One-time or annual event</option>
          </select>
        </div>

        <div class="form-row form-row--split">
          <div>
            <label for="schedule">Day(s) &amp; time, or date</label>
            <input id="schedule" name="schedule" type="text" placeholder="e.g. Tuesdays, 6pm or June 13, 2027" />
          </div>
          <div>
            <label for="distance">Distance &amp; pace</label>
            <input id="distance" name="distance" type="text" placeholder="e.g. 20mi, 16-18mph, no-drop" />
          </div>
        </div>

        <div class="form-row">
          <label for="terrain">Terrain</label>
          <select id="terrain" name="terrain">
            <option value="">Select one…</option>
            <option value="road">Road</option>
            <option value="gravel">Gravel</option>
            <option value="mountain">Mountain / Singletrack</option>
            <option value="trail">Trail / Path</option>
            <option value="mixed">Mixed</option>
          </select>
        </div>

        <div class="form-row">
          <label for="location">Start location</label>
          <input id="location" name="location" type="text" placeholder="Name and/or address" />
        </div>

        <div class="form-row">
          <label for="website">Website / social link</label>
          <input id="website" name="website" type="url" placeholder="https://…" />
        </div>

        <div class="form-row">
          <label for="details">Anything else we should know?</label>
          <textarea id="details" name="details" rows="4"></textarea>
        </div>

        <div class="form-row form-row--split">
          <div>
            <label for="submitter-name">Your name</label>
            <input id="submitter-name" name="submitter-name" type="text" />
          </div>
          <div>
            <label for="submitter-email">Your email</label>
            <input id="submitter-email" name="submitter-email" type="email" placeholder="In case we have questions" />
          </div>
        </div>

        <button type="submit" class="btn btn--primary">Submit ride</button>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .container--narrow {
    max-width: 42rem;
  }

  .submit-form {
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    padding: var(--space-4);
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .form-row {
    display: flex;
    flex-direction: column;
    gap: 0.4em;
  }

  .form-row--split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .form-row label {
    font-weight: 600;
    font-size: 0.9rem;
  }

  .form-row input,
  .form-row select,
  .form-row textarea {
    font: inherit;
    padding: 0.6em 0.8em;
    border: 1.5px solid var(--color-line-strong);
    border-radius: var(--radius-sm);
    background: var(--color-paper);
  }

  .form-row input:focus,
  .form-row select:focus,
  .form-row textarea:focus {
    outline: 3px solid var(--color-gold);
    outline-offset: 1px;
  }

  .submit-form .btn {
    align-self: flex-start;
    margin-top: var(--space-2);
  }

  @media (max-width: 600px) {
    .form-row--split {
      grid-template-columns: 1fr;
    }
  }
</style>
