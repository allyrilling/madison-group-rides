---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import IsthmusMotif from '../components/IsthmusMotif.astro';
import CapitolGlyph from '../components/CapitolGlyph.astro';
import Icon from '../components/Icon.astro';
import ListingCard from '../components/ListingCard.astro';
import { resolveOrganizerName } from '../lib/organizer';
import { formatDistance, formatEventDate, formatRideSchedule, PACE_LABELS, DROP_LABELS } from '../lib/labels';

const featuredRides = await getCollection('rides', ({ data }) => data.active && data.featured);
const featuredEvents = await getCollection('events', ({ data }) => data.active && data.featured);

const rideCards = await Promise.all(
  featuredRides.map(async (ride) => ({
    kind: 'ride' as const,
    href: `/rides/${ride.id}/`,
    name: ride.data.name,
    organizerName: await resolveOrganizerName(ride.data),
    metaLine: formatRideSchedule(ride.data),
    distanceLabel: formatDistance(ride.data.distanceMiles),
    paceLabel: PACE_LABELS[ride.data.paceCategory],
    dropLabel: DROP_LABELS[ride.data.dropStyle],
    terrain: ride.data.terrain,
  }))
);

const eventCards = await Promise.all(
  featuredEvents.map(async (event) => ({
    kind: 'event' as const,
    href: `/events/${event.id}/`,
    name: event.data.name,
    organizerName: await resolveOrganizerName(event.data),
    metaLine: formatEventDate(event.data),
    distanceLabel: formatDistance(event.data.distanceMiles),
    paceLabel: event.data.paceCategory ? PACE_LABELS[event.data.paceCategory] : null,
    dropLabel: null,
    terrain: event.data.terrain,
  }))
);

const featured = [...rideCards, ...eventCards];

const allRideCount = (await getCollection('rides', ({ data }) => data.active)).length;
const allEventCount = (await getCollection('events', ({ data }) => data.active)).length;
---

<BaseLayout title="Bike Madison">
  <section class="hero">
    <IsthmusMotif class="hero__motif" />
    <CapitolGlyph class="hero__capitol" />
    <div class="container hero__inner">
      <p class="eyebrow">Madison, Wisconsin</p>
      <h1>Rides, shops, clubs, and events — all in one place.</h1>
      <p class="lede">
        A catalog of {allRideCount}+ recurring group bike rides, {allEventCount} organized events, and every
        bike shop and cycling club around Madison — road, gravel, and mountain bike alike. Filter by day, pace,
        or terrain, browse the map, or just find your people on two wheels.
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="/rides/">Browse recurring rides</a>
        <a class="btn btn--secondary" href="/events/">See upcoming events</a>
        <a class="btn btn--ghost" href="/map/">
          <Icon name="map" /> View the map
        </a>
      </div>
    </div>
    <svg class="hero__wave" viewBox="0 0 1440 100" preserveAspectRatio="none" aria-hidden="true">
      <path
        d="M0,50 C120,90 240,10 360,50 C480,90 600,10 720,50 C840,90 960,10 1080,50 C1200,90 1320,10 1440,50 L1440,100 L0,100 Z"
        fill="var(--color-paper)"
      ></path>
    </svg>
  </section>

  {
    featured.length > 0 && (
      <section class="section">
        <div class="container">
          <p class="eyebrow">Featured</p>
          <h2>Good places to start</h2>
          <div class="card-grid">
            {featured.map((card) => (
              <ListingCard
                href={card.href}
                name={card.name}
                organizerName={card.organizerName}
                metaLine={card.metaLine}
                distanceLabel={card.distanceLabel}
                paceLabel={card.paceLabel}
                dropLabel={card.dropLabel}
                terrain={card.terrain}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

</BaseLayout>

<style>
  .hero {
    position: relative;
    background: var(--color-lake-bright);
    color: var(--color-ink);
    overflow: hidden;
    padding-block: var(--space-6);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    max-width: 42rem;
  }

  .hero__wave {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    width: 100%;
    height: 4.5rem;
    z-index: 1;
    display: block;
  }

  .hero .eyebrow {
    color: var(--color-ink);
  }

  .hero h1 {
    color: var(--color-ink);
  }

  .hero .lede {
    color: rgba(36, 36, 36, 0.85);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .hero__actions .btn--secondary {
    border-color: var(--color-ink);
    color: var(--color-ink);
  }

  .hero__actions .btn--ghost {
    color: var(--color-ink);
  }
</style>

<style is:global>
  /* Astro's scoped-style attribute doesn't reach elements rendered inside a
     child component (IsthmusMotif), so this positioning must stay global. */
  .hero__motif {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.5;
    --motif-fill: var(--color-paper);
  }

  .hero__capitol {
    position: absolute;
    top: 1.5rem;
    right: 2rem;
    width: 2.25rem;
    height: auto;
  }
</style>

<script>
  // Handles Netlify Identity's invite/reset-password redirect flow for the
  // Decap CMS admin at /admin — required regardless of which page the
  // invitation link happens to land on.
  import netlifyIdentity from 'netlify-identity-widget';
  netlifyIdentity.init();
  netlifyIdentity.on('init', (user: unknown) => {
    if (!user) {
      netlifyIdentity.on('login', () => {
        document.location.href = '/admin/';
      });
    }
  });
</script>
