---
import { getCollection, render } from 'astro:content';
import DetailPage from '../../components/DetailPage.astro';
import { resolveOrganizerEntry } from '../../lib/organizer';
import {
  formatDistance,
  formatPace,
  formatRideSchedule,
  PACE_LABELS,
  DROP_LABELS,
  TERRAIN_LABELS,
  TERRAIN_ICONS,
} from '../../lib/labels';

export async function getStaticPaths() {
  const rides = await getCollection('rides');
  return rides.map((ride) => ({ params: { slug: ride.id }, props: { ride } }));
}

const { ride } = Astro.props;
const { Content } = await render(ride);
const organizer = await resolveOrganizerEntry(ride.data);
const organizerName = organizer?.data.name ?? ride.data.organizerName;

const distanceLabel = formatDistance(ride.data.distanceMiles);
const paceLabel = formatPace(ride.data.paceMph) ?? PACE_LABELS[ride.data.paceCategory];
const dropLabel = DROP_LABELS[ride.data.dropStyle];

const badges: { icon: 'ruler' | 'gauge' | 'users' | 'road' | 'gravel' | 'mountain' | 'trail' | 'bike'; label: string }[] = [];
if (distanceLabel) badges.push({ icon: 'ruler', label: distanceLabel });
if (paceLabel) badges.push({ icon: 'gauge', label: paceLabel });
if (dropLabel) badges.push({ icon: 'users', label: dropLabel });
for (const t of ride.data.terrain) {
  badges.push({ icon: TERRAIN_ICONS[t] ?? 'bike', label: TERRAIN_LABELS[t] ?? t });
}

const mapMarkers =
  ride.data.startLocation.lat != null && ride.data.startLocation.lng != null
    ? [
        {
          id: ride.id,
          kind: 'ride' as const,
          name: ride.data.name,
          organizerName,
          lat: ride.data.startLocation.lat,
          lng: ride.data.startLocation.lng,
          href: `/rides/${ride.id}/`,
          summary: formatRideSchedule(ride.data),
        },
      ]
    : [];
---

<DetailPage
  eyebrow="Recurring Ride"
  title={ride.data.name}
  scheduleLabel={formatRideSchedule(ride.data)}
  badges={badges}
  description={ride.data.description}
  locationName={ride.data.startLocation.name}
  locationAddress={ride.data.startLocation.address}
  cost={ride.data.cost}
  organizerName={organizerName}
  organizerWebsite={organizer?.data.website}
  organizerSocial={organizer?.data.social}
  website={ride.data.website}
  sourceUrl={ride.data.sourceUrl}
  notes={ride.data.notes}
  active={ride.data.active}
  winterHiatus={ride.data.winterHiatus}
  mapMarkers={mapMarkers}
  backHref="/rides/"
  backLabel="All recurring rides"
>
  <Content />
</DetailPage>
